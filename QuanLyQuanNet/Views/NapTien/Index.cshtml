@{
    ViewBag.Title = "Nạp tiền";
}
<div style="min-height: 100vh; background-color: #ffe6f0; padding-top: 50px; padding-bottom: 50px;">
    <h2 class="text-center">Nạp tiền vào tài khoản</h2>

    @using (Html.BeginForm())
    {
        <div class="form-group">
            <label for="soTien">Số tiền (VNĐ):</label>
            <input type="number" id="soTien" name="soTien" class="form-control" required min="1000" placeholder="Nhập số tiền cần nạp" />
        </div>

        <div class="form-group text-center">
            <button type="submit" class="btn btn-success">Nạp tiền</button>
        </div>}


    @if (TempData["ThongBao"] != null)
    {
        <div class="alert alert-success text-center">
            @TempData["ThongBao"]
        </div>
    }

    <div class="text-center mt-3">
        <a href="@Url.Action("Index", "User")" class="btn btn-link">⬅️ Quay lại trang chính</a>
    </div>
