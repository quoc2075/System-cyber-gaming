@model QuanLyQuanNet.Models.NguoiDung
@{
    ViewBag.Title = "Thay đổi thông tin người dùng";
    Layout = null; // Nếu bạn dùng Layout.cshtml thì nên đặt style trong đó
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
</head>
<body style="background-color: #ffe6f0;">
    <div class="container mt-5">
        <div class="card shadow p-4">
            <h2 class="text-center text-primary mb-4">✏️ Sửa thông tin người dùng</h2>

            @using (Html.BeginForm())
            {
                @Html.HiddenFor(m => m.MaNguoiDung)

                <div class="mb-3">
                    <label class="form-label">Họ tên</label>
                    @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control" })
                </div>

                <div class="mb-3">
                    <label class="form-label">Mật khẩu</label>
                    @Html.TextBoxFor(m => m.MatKhau, new { @class = "form-control" })
                </div>

                <div class="mb-3">
                    <label class="form-label">Số điện thoại</label>
                    @Html.TextBoxFor(m => m.SoDienThoai, new { @class = "form-control" })
                </div>

                <div class="mb-3">
                    <label class="form-label">Vai trò</label>
                    @Html.DropDownListFor(m => m.VaiTro, new SelectList(new[] {
                        new { Value = "user", Text = "Người dùng" },
                        new { Value = "admin", Text = "Quản trị viên" }
                    }, "Value", "Text", Model.VaiTro), new { @class = "form-select" })
                </div>

                <button type="submit" class="btn btn-success w-100">Lưu thay đổi</button>
            }

            <div class="mt-3 text-center">
                <a href="@Url.Action("Index", "AdminNguoiDung")" class="btn btn-outline-secondary">⬅️ Quay lại danh sách</a>
            </div>
        </div>
    </div>
</body>
</html>
